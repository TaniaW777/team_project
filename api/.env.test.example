# EventPass API - TEST environment template (fake, test-only values).
# Copy to .env.test (ignored by Git) before running the tests:
#   copy .env.test.example .env.test      (Windows)
#   cp .env.test.example .env.test        (macOS / Linux / CI)
#
# The tests use the `mongo-test` container of docker-compose.yml (in-memory,
# separate from your development data): start it with `npm run db:up`.
# Safety: the test helpers refuse to run unless NODE_ENV=test AND the
# database name in MONGO_URI ends with "_test". The tests drop that database.

NODE_ENV=test
PORT=3001
MONGO_URI=mongodb://127.0.0.1:27028/eventpass_test?directConnection=true&serverSelectionTimeoutMS=5000
CORS_ORIGIN=*

# Fake value, valid only for the automated tests. Never reuse it anywhere.
JWT_ACCESS_SECRET=test-only-fake-secret-not-for-any-real-environment
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Fake Ed25519 PKCS8 key for QR tests only. Never reuse it anywhere else.
QR_SIGNING_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIKpKfGdj2/v5p94MFBBrpeRzK4g4wRRSokNiT3s8R9O1\n-----END PRIVATE KEY-----\n
QR_TTL_GRACE_SECONDS=43200
