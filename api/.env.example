# EventPass API - environment template.
# Copy to .env (ignored by Git) and adjust:  copy .env.example .env
# Every variable is validated at startup by src/config/env.ts.
# NEVER put real secrets or production values in this file.

NODE_ENV=development
PORT=3000
# Local development database: the `mongo` container of docker-compose.yml
# (start it with `npm run db:up`, see docs/development-database.md).
# directConnection=true: talk to the single-node replica set directly.
# On Atlas use the mongodb+srv:// string from the Atlas UI instead (set it in
# the hosting platform's secret settings, never in a committed file).
MONGO_URI=mongodb://127.0.0.1:27027/eventpass_dev?directConnection=true&serverSelectionTimeoutMS=5000
# Allowed browser origin (e.g. https://app.example.com), or * while developing.
# The mobile app is not affected by CORS; restrict this in production.
CORS_ORIGIN=*
# Number of reverse proxies in front of the API: 0 locally, usually 1 on a
# hosting platform (its load balancer). Keeps the login rate limit per client.
TRUST_PROXY=0

# ---- Authentication ----
# Left EMPTY on purpose: the API refuses to start until you set your own
# secret (at least 32 characters). Generate one and paste it in .env:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Lifetime of the access token: a number followed by s, m, h or d.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- QR check-in (Member 4) ----
# Development-only Ed25519 key, NOT A SECRET: generate your own for real use:
#   node -e "const {generateKeyPairSync}=require('node:crypto'); console.log(generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}).replaceAll('\n','\\n'))"
# Store the production key as a platform secret, never in a committed file.
QR_SIGNING_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIE14ovR/anoe9xHzktsIaQgokhGPHsMVlo1mM9nYVl8o\n-----END PRIVATE KEY-----\n
# QR validity after the event ends, in seconds (12 h, TD7).
QR_TTL_GRACE_SECONDS=43200
