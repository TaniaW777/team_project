{
  "name": "eventpass-api",
  "version": "1.0.0",
  "description": "EventPass API: campus events, registration and QR access control (Node.js + Express 5 + MongoDB)",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env.test --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:status": "docker compose ps",
    "promote-admin": "node --env-file-if-exists=.env scripts/promote-admin.ts"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "mongoose": "^9.13.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.4",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2"
  }
}
